---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Footer from '../components/Footer.astro';
import { Picture } from 'astro:assets';
import hero from '../assets/hero.jpg';

const title = 'Fred Abood';
const description =
  'Fred Abood is Field CTO for Global SI Partnerships at Databricks, leading the Accenture partnership. AI and data strategy, partner ecosystems, generative AI and enterprise go-to-market.';

// Google documents ProfilePage with a Person mainEntity for single-person sites.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Fred Abood',
    description,
    url: 'https://fredabood.com',
    image: 'https://fredabood.com/og.jpg',
    jobTitle: 'Field CTO, Global SI Partnerships',
    worksFor: { '@type': 'Organization', name: 'Databricks', url: 'https://www.databricks.com' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Colorado Boulder' },
    homeLocation: { '@type': 'Place', name: 'Michigan, United States' },
    knowsAbout: [
      'AI strategy',
      'Data strategy',
      'Generative AI',
      'Agentic AI',
      'Strategic alliances',
      'Partner ecosystems',
      'Systems integrators',
      'Enterprise go-to-market',
      'Databricks',
      'Lakehouse architecture',
      'Enterprise architecture',
    ],
    sameAs: [
      'https://www.linkedin.com/in/fredabood',
      'https://github.com/fredabood',
      'https://x.com/fredabood',
      'https://instagram.com/fredabood',
    ],
  },
};
---

<BaseLayout title={title} description={description} ogType="profile" fullBleed>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personSchema)} />
  <section class="hero">
    <div class="hero-content">
      <div class="hero-inner">
        <h1>Fred Abood</h1>
        <p class="headline">
          <strong>AI &amp; Data Strategy</strong> | <strong>Partner Ecosystems</strong> | <strong>Enterprise GTM</strong>
        </p>
        <p class="bio">
          I turn data and AI platforms into enterprise value, through the partners who deliver them.
        </p>
        <p class="bio">
          Today I'm a Databricks Field Engineering leader focused on our largest SI partnerships. I
          spend my time with the founders and practice leaders building on Databricks.
        </p>
        <p class="bio">Analyst turned architect who still loves to build.</p>
        <blockquote class="open">
          I'm always glad to talk with founders and investors working on data and AI.
        </blockquote>
        <div class="contact-row">
          <SocialLinks size={18} linkedinLabel="Get in touch" icons={['linkedin', 'github', 'x', 'instagram']} />
        </div>
      </div>
    </div>
    <div class="hero-image">
      <Picture
        src={hero}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1440]}
        sizes="(max-width: 800px) 100vw, 60vw"
        alt="Fred Abood"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <div class="home-footer">
    <Footer />
  </div>
</BaseLayout>

<style>
  /* Desktop: the hero is exactly one viewport tall, so nothing scrolls. The photo is
     absolutely positioned so it fills its column without driving the page height. */
  .hero {
    display: grid;
    grid-template-columns: minmax(32rem, 2fr) minmax(0, 3fr);
    min-height: 100vh;
    min-height: 100dvh;
  }

  .hero-content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 2.5rem;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    max-width: 460px;
  }

  h1 {
    margin-bottom: 0.5rem;
    font-size: 2.5rem;
  }

  .headline {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--heading);
    margin-bottom: 1rem;
  }

  /* Wrap only at the separators, never inside a phrase. */
  .headline strong {
    white-space: nowrap;
  }

  .bio {
    font-size: 1rem;
    margin-bottom: 0.9rem;
    color: var(--text);
  }

  .hero-image {
    position: relative;
    line-height: 0;
    overflow: hidden;
  }

  .hero-image :global(picture) {
    position: absolute;
    inset: 0;
  }

  .hero-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The person's center in the photo; cover-cropping keeps this point fixed, so the subject stays in frame. */
    object-position: 31% 68%;
  }

  .contact-row {
    align-self: stretch;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .contact-row :global(.social-links) {
    flex: 1;
    gap: 0.6rem;
  }

  .contact-row :global(.social-link) {
    width: 2.5rem;
    height: 2.5rem;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background: var(--heading);
    color: var(--bg);
    transition: transform var(--transition), background var(--transition);
  }

  .contact-row :global(.social-link:hover) {
    background: var(--accent);
    color: var(--bg);
    transform: translateY(-2px);
  }

  /* LinkedIn is the filled primary pill with its label inside; the others are outlined circles. */
  .contact-row :global(.social-link--linkedin) {
    width: auto;
    gap: 0.5rem;
    padding: 0 1.25rem;
    border-radius: 2rem;
    border: 1.5px solid var(--heading);
    font-size: 0.85rem;
    font-weight: 500;
    /* Pushes the remaining icons to the right edge of the column. */
    margin-right: auto;
  }

  .contact-row :global(.social-link:not(.social-link--linkedin)) {
    background: transparent;
    color: var(--heading);
    border: 1.5px solid var(--heading);
  }

  .contact-row :global(.social-link:not(.social-link--linkedin):hover) {
    background: var(--heading);
    color: var(--bg);
  }

  .open {
    margin: 0.6rem 0 1.5rem;
    font-size: 0.95rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--highlight);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  @media (min-width: 801px) {
    .home-footer { display: none; }
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .hero-image { order: -1; height: 50vh; }
    .hero-content { padding: 2.5rem 1.5rem; }
    h1 { font-size: 2rem; }

  }
</style>
